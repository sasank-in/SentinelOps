# Copy to .env and adjust. docker compose reads .env automatically.

POSTGRES_PASSWORD=postgres

ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders
PAYMENTS_DB_USER=payments
PAYMENTS_DB_PASSWORD=payments

# Release under test. The "bad deployment" demo sets PAYMENT_VERSION=1.8.2 together
# with PAYMENT_DB_POOL_SIZE=2 and PAYMENT_FRAUD_CHECK_DELAY=500ms.
GATEWAY_VERSION=1.0.0
ORDER_VERSION=1.0.0
PAYMENT_VERSION=1.8.1
PAYMENT_DB_POOL_SIZE=10
PAYMENT_FRAUD_CHECK_DELAY=0ms

# Enables the /failure/* endpoints. Remove "chaos" to disable failure injection.
SPRING_PROFILES_ACTIVE=chaos
